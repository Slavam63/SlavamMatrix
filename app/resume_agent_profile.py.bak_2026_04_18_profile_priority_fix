def _clean_text(value: str) -> str:
    value = (value or "").strip()
    value = re.sub(r"\s+", " ", value)
    return value.strip(" ,;.-")


def _clean_list(items: list[str]) -> list[str]:
    result = []
    seen = set()

    for item in items:
        value = _clean_text(item)
        if not value:
            continue
        key = value.lower()
        if key in seen:
            continue
        seen.add(key)
        result.append(value)

    return result


def _normalize_role(value: str) -> str:
    text = _clean_text(value)
    if not text:
        return ""

    text = re.sub(r"^\s*и\s+зарплата\s*", "", text, flags=re.I)
    text = re.sub(r"\bи\s+зарплата\b", "", text, flags=re.I)
    text = _clean_text(text)
    text_lower = text.lower()

    for canonical, variants in ROLE_SYNONYMS.items():
        if any(variant in text_lower for variant in variants):
            return canonical.capitalize()

    if text_lower.startswith("руководителя "):
        text = re.sub(r"^руководителя ", "руководитель ", text, flags=re.I)
    if text_lower.startswith("директора "):
        text = re.sub(r"^директора ", "директор ", text, flags=re.I)

    return text.capitalize() if text else ""


def _is_probable_role(value: str) -> bool:
    text = _clean_text(value)
    if not text:
        return False

    text_lower = text.lower()

    reject_markers = [
        "диплом",
        "acca",
        "cima",
        "cpa",
        "certificate",
        "certification",
        "training",
        "school",
        "university",
        "education",
        "курс",
        "обучение",
        "сертификат",
        "международной финансовой отчетности",
        "отчетности",
        "hock",
        "ielts",
        "toefl",
        "ключевые компетенции",
        "личные качества",
        "дополнительные навыки",
        "растущий бизнес",
        "трансформации компаний",
    ]
    if any(marker in text_lower for marker in reject_markers):
        return False

    company_markers = [
        "ооо",
        "ао",
        "пао",
        "зао",
        "оао",
        "llc",
        "inc",
        "ltd",
        "group",
        "гк ",
        "группа компаний",
    ]
    if any(marker in text_lower for marker in company_markers):
        return False

    if text.startswith("•") or text.startswith("-"):
        return False

    if '"' in text or "«" in text or "»" in text:
        return False

    if len(text.split()) > 6:
        return False

    allowed_role_markers = [
        "директор",
        "руководитель",
        "head",
        "chief",
        "officer",
        "manager",
        "lead",
        "генераль",
        "исполнитель",
        "операцион",
        "финансов",
        "коммерческ",
        "sales",
        "продаж",
        "business development",
        "развитию бизнеса",
        "product",
        "project",
        "innovation",
        "transformation",
        "продукт",
        "проект",
        "инновац",
        "трансформац",
    ]

    return any(marker in text_lower for marker in allowed_role_markers)


def _extract_role_candidates(text: str, mapped_position: str) -> list[str]:
    candidates = []
    text_lower = text.lower()

    executive_priority = [
        ("Генеральный директор", [
            "генеральный директор",
            "гендиректор",
            "ceo",
            "chief executive officer",
            "управляющий директор",
            "managing director",
            "член совета директоров",
        ]),
        ("Исполнительный директор", [
            "исполнительный директор",
            "executive director",
        ]),
        ("Операционный директор", [
            "операционный директор",
            "coo",
            "chief operating officer",
            "operations director",
        ]),
        ("Финансовый директор", [
            "финансовый директор",
            "cfo",
            "finance director",
            "head of finance",
        ]),
        ("Коммерческий директор", [
            "коммерческий директор",
            "chief commercial officer",
            "commercial director",
            "cco",
        ]),
        ("Директор по продажам", [
            "директор по продажам",
            "sales director",
            "head of sales",
        ]),
        ("Директор по развитию бизнеса", [
            "директор по развитию бизнеса",
            "business development director",
            "head of business development",
        ]),
    ]

    for canonical, variants in executive_priority:
        if any(variant in text_lower for variant in variants):
            candidates.append(canonical)

    match = re.search(
        r"желаемая должность(?:\s+и\s+зарплата)?\s*(.+?)(?:ключевые компетенции|занятость:|график:|о себе|опыт работы|$)",
        text,
        flags=re.I | re.S,
    )
    if match:
        block = _clean_text(match.group(1))
        block = re.sub(r"\bи\s+зарплата\b", "", block, flags=re.I)
        parts = re.split(r"/|\||;|\n|, (?=[А-ЯA-Z])", block)
        for part in parts:
            role = _normalize_role(part)
            if role and _is_probable_role(role):
                candidates.append(role)

    if mapped_position:
        normalized_mapped = _normalize_role(mapped_position)
        if normalized_mapped and _is_probable_role(normalized_mapped):
            candidates.append(normalized_mapped)

    for canonical in ROLE_SYNONYMS.keys():
        if canonical in text_lower:
            candidates.append(canonical.capitalize())

    filtered_candidates = []
    seen = set()
    for role in candidates:
        normalized = _normalize_role(role)
        if not normalized or not _is_probable_role(normalized):
            continue
        key = normalized.lower()
        if key in seen:
            continue
        seen.add(key)
        filtered_candidates.append(normalized)

    return filtered_candidates


def _has_any(text: str, patterns: list[str]) -> bool:
    return any(re.search(pattern, text, flags=re.I) for pattern in patterns)


def _normalize_location(value: str) -> str:
    text = _clean_text(value)
    if not text:
        return ""

    text = re.split(
        r"\b(?:гражданство|разрешение на работу|готов к переезду|готова к переезду|готов к командировкам|готова к командировкам)\b",
        text,
        maxsplit=1,
        flags=re.I,
    )[0]
    text = re.split(r"[;|,/]", text, maxsplit=1)[0]
    return _clean_text(text)


def _is_sales_core(text: str, primary_role: str) -> bool:
    text_lower = text.lower()
    role_lower = (primary_role or "").lower()

    sales_score = sum(1 for marker in SALES_MARKERS if marker in text_lower)
    role_sales = any(
        marker in role_lower
        for marker in ["коммерческ", "продаж", "business development", "развитию бизнеса", "cco"]
    )

    return sales_score >= 4 or role_sales


def _is_industrial_core(text: str) -> bool:
    text_lower = text.lower()
    score = sum(1 for marker in INDUSTRIAL_MARKERS if marker in text_lower)
    return score >= 2


def _has_it_enterprise_context(text: str) -> bool:
    text_lower = text.lower()
    score = sum(1 for marker in IT_ENTERPRISE_MARKERS if marker in text_lower)
    return score >= 3


def _prefer_russian_output(text: str, current_form_data: dict[str, Any]) -> bool:
    location = _clean_text(current_form_data.get("location") or "").lower()
    if any(marker in location for marker in RUSSIAN_LOCATION_MARKERS):
        return True

    if "россия" in text.lower():
        return True

    cyrillic_count = len(re.findall(r"[А-Яа-яЁё]", text))
    latin_count = len(re.findall(r"[A-Za-z]", text))

    return cyrillic_count >= latin_count


def _infer_primary_industry(
    mapped_query_text: str,
    text: str,
    product_domain: str,
    primary_role: str,
) -> tuple[str, list[str]]:
    adjacent = []
    text_lower = text.lower()
    mapped_clean = _clean_text(mapped_query_text)

    if product_domain == "food_product":
        return "FMCG / Retail / Пищевая отрасль", adjacent

    if _has_any(text, TRAVEL_PATTERNS):
        adjacent.append("Travel / Hospitality / CX")

    if _is_industrial_core(text):
        return "Производство / Инжиниринг", _clean_list(adjacent)

    if _is_sales_core(text, primary_role):
        if _has_it_enterprise_context(text):
            adjacent.append("IT / Digital / Product")
        return "Продажи / Развитие бизнеса", _clean_list(adjacent)

    if _has_any(text, PRODUCT_PATTERNS + INNOVATION_PATTERNS + TRANSFORMATION_PATTERNS + AI_PATTERNS):
        return "IT / Digital / Product", _clean_list(adjacent)

    if mapped_clean and mapped_clean.lower() not in {"другое", "другое / other", "other"}:
        return mapped_clean, _clean_list(adjacent)

    if any(role_marker in text_lower for role_marker in [
        "генеральный директор",
        "исполнительный директор",
        "операционный директор",
        "управляющий директор",
    ]):
        return "Операционное управление", _clean_list(adjacent)

    return "", _clean_list(adjacent)


