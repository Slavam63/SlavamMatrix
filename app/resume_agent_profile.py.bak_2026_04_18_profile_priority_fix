            elif "генераль" in role_lower or "исполнитель" in role_lower:
                keywords.extend(["operations management", "business development"])
            else:
                keywords.extend(GENERIC_EXECUTIVE_KEYWORDS_EN)

    allow_adjacent_keywords = not (is_industrial_core or is_digital_core or is_sales_core)
    if adjacent and allow_adjacent_keywords:
        if prefer_russian:
            keywords.extend(["туризм", "гостеприимство"])
        else:
            keywords.extend(["travel", "hospitality"])

    return _clean_list(keywords)[:8]


def _build_clarification_question(primary_role: str, alternate_roles: list[str], adjacent_contexts: list[str]) -> str:
    if len(alternate_roles) >= 2:
        return (
            f"Я предполагаю, что ваш основной запрос — «{primary_role}». "
            f"Нужно ли также искать смежные роли: {', '.join(alternate_roles[:3])}?"
        )

    if adjacent_contexts:
        return (
            f"Я понял ваш профиль как «{primary_role}». "
            f"Нужно ли отдельно учитывать контекст: {', '.join(adjacent_contexts)}?"
        )

    return (
        f"Я понял ваш основной запрос как «{primary_role}». "
        "Хотите скорректировать приоритет роли или отрасли перед поиском?"
    )


def _detect_experience_anchor(text: str, primary_role: str) -> dict[str, str]:
    text_lower = text.lower()
    role_lower = (primary_role or "").lower()

    industrial_corporate_markers = [
        "сибур",
        "холдинг",
        "производствен",
        "промышлен",
        "машиностро",
        "электрооборуд",
        "инжинир",
        "завод",
        "корпоративн",
    ]

    digital_innovation_markers = [
        "цифров",
        "innovation",
        "инновац",
        "ml",
        "llm",
        "data-driven",
        "product portfolio",
        "mvp",
        "лаборатор",
    ]

    travel_markers = [
        "travel",
        "туризм",
        "гостеприим",
        "путешеств",
        "travel-проект",
    ]

    sales_markers = [
        "продаж",
        "sales",
        "коммерческ",
        "commercial",
        "business development",
        "развитию бизнеса",
        "канальн",
        "партнерск",
        "crm",
        "воронк",
        "p&l",
        "kpi",
        "okr",
    ]

    industrial_score = sum(1 for marker in industrial_corporate_markers if marker in text_lower)
    digital_score = sum(1 for marker in digital_innovation_markers if marker in text_lower)
    travel_score = sum(1 for marker in travel_markers if marker in text_lower)
    sales_score = sum(1 for marker in sales_markers if marker in text_lower)

    if industrial_score >= 2 and digital_score >= 2:
        return {
            "primary_industry_override": "Производство / Инжиниринг",
            "anchor_type": "industrial_digital_corporate",
        }

    if sales_score >= 4 or any(x in role_lower for x in ["коммерческ", "продаж", "business development", "развитию бизнеса", "cco"]):
        return {
            "primary_industry_override": "Продажи / Развитие бизнеса",
            "anchor_type": "commercial_sales_corporate",
        }

    if digital_score >= 3 and travel_score >= 2:
        return {
            "primary_industry_override": "IT / Digital / Product",
            "anchor_type": "digital_core_with_travel_context",
        }

    return {
        "primary_industry_override": "",
        "anchor_type": "",
    }


def _build_reasoning(
    primary_role: str,
    alternate_roles: list[str],
    primary_industry: str,
    adjacent_contexts: list[str],
    text: str,
) -> str:
    reasons = [f"Основная роль определена как: {primary_role}"]
    if alternate_roles:
        reasons.append(f"Смежные роли: {', '.join(alternate_roles[:3])}")
    if primary_industry:
        reasons.append(f"Основная отрасль: {primary_industry}")

    markers = []
    if _has_any(text, PRODUCT_PATTERNS):
        markers.append("product")
    if _has_any(text, INNOVATION_PATTERNS):
        markers.append("innovation")
    if _has_any(text, TRANSFORMATION_PATTERNS):
        markers.append("transformation")
    if _is_sales_core(text, primary_role):
        markers.append("sales/commercial")
    if _has_it_enterprise_context(text):
        markers.append("it-enterprise")
    if adjacent_contexts:
        markers.extend(adjacent_contexts)

    if markers:
        reasons.append(f"Ключевые смысловые маркеры: {', '.join(_clean_list(markers))}")

    return " | ".join(reasons)


def build_resume_agent_profile(resume_text: str, current_form_data: dict[str, Any] | None = None) -> dict[str, Any]:
    current_form_data = current_form_data or {}
    text = _clean_text(resume_text)
    mapped = map_resume_to_form_data(text)
    product_domain_info = detect_product_domain(text)
    product_domain = product_domain_info.get("product_domain", "unknown")

    role_candidates = _extract_role_candidates(text, mapped.get("position") or "")
    primary_role = role_candidates[0] if role_candidates else _normalize_role(current_form_data.get("position") or "") or "Руководитель"
    alternate_roles = role_candidates[1:3]

    primary_industry, adjacent_contexts = _infer_primary_industry(
        mapped_query_text=(mapped.get("query_text") or current_form_data.get("query_text") or ""),
        text=text,
        product_domain=product_domain,
        primary_role=primary_role,
    )

    experience_anchor = _detect_experience_anchor(text, primary_role)
    if experience_anchor.get("primary_industry_override"):
        primary_industry = experience_anchor["primary_industry_override"]

    prefer_russian = _prefer_russian_output(text, current_form_data)
    keywords = _build_keywords(primary_role, primary_industry, text, adjacent_contexts, prefer_russian)

    recommended_form_fields = {
        "position": primary_role,
        "query_text": primary_industry,
        "keywords": ", ".join(keywords),
        "location": _normalize_location(current_form_data.get("location") or mapped.get("location") or ""),
        "email": _clean_text(current_form_data.get("email") or mapped.get("email") or "").lower(),
        "salary_min": _clean_text(str(current_form_data.get("salary_min") or mapped.get("salary_min") or "")),
        "employment_type": _clean_text(current_form_data.get("employment_type") or mapped.get("employment_type") or ""),
        "work_format": _clean_text(current_form_data.get("work_format") or mapped.get("work_format") or ""),
        "remote": bool(current_form_data.get("remote") or mapped.get("remote")),
    }

    clarification_question = _build_clarification_question(
        primary_role=primary_role,
        alternate_roles=alternate_roles,
        adjacent_contexts=adjacent_contexts,
    )

    reasoning = _build_reasoning(
        primary_role=primary_role,
        alternate_roles=alternate_roles,
        primary_industry=primary_industry,
        adjacent_contexts=adjacent_contexts,
        text=text,
    )

    confidence = 0.55
    if primary_role:
        confidence += 0.15
    if primary_industry:
        confidence += 0.1
    if alternate_roles:
        confidence += 0.05
    if adjacent_contexts:
        confidence += 0.05
    confidence = min(confidence, 0.9)

    profile = ResumeAgentProfile(
        primary_role=primary_role,
        alternate_roles=alternate_roles,
        primary_industry=primary_industry,
        adjacent_contexts=adjacent_contexts,
        recommended_form_fields=recommended_form_fields,
        clarification_question=clarification_question,
        reasoning=reasoning,
        confidence=confidence,
    )

    return profile.to_dict()
