<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Матрица - парсинг вакансий</title>

    <link rel="icon" type="image/x-icon" href="{{ url_for('static', filename='favicon.ico') }}">
    <link rel="icon" type="image/png" href="{{ url_for('static', filename='favicon.png') }}">

    {% set request_id = job_request_id if job_request_id is defined else (job_request.id if job_request is defined and job_request else 0) %}

    <style>
        :root {
            --gold-soft: #f9fcba;
            --gold-dim: rgba(249, 252, 186, 0.82);
            --border: rgba(249, 252, 186, 0.68);
            --panel-bg: rgba(58, 31, 4, 0.20);
            --panel-bg-soft: rgba(34, 19, 2, 0.26);
            --button-bg: linear-gradient(180deg, rgba(239, 214, 136, 0.20) 0%, rgba(200, 160, 65, 0.16) 100%);
            --button-hover-bg: rgba(20, 82, 41, 0.88);
            --hover-red: #d64040;
            --panel-blur: blur(8px);
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            min-height: 100%;
            font-family: Georgia, "Times New Roman", serif;
            color: var(--gold-soft);
            background:
                linear-gradient(rgba(20, 13, 5, 0.42), rgba(20, 13, 5, 0.62)),
                linear-gradient(180deg, rgba(33, 22, 9, 0.10) 0%, rgba(18, 13, 7, 0.72) 100%),
                url("https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=2400&q=100") center center / cover no-repeat fixed;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            background:
                radial-gradient(circle at 50% 16%, rgba(255, 227, 158, 0.16), transparent 28%),
                linear-gradient(180deg, rgba(13, 9, 5, 0.08) 0%, rgba(13, 9, 5, 0.42) 100%);
        }

        .page {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            padding: 12px 16px 20px;
        }

        .top-composition {
            width: 100%;
            max-width: 1220px;
            margin: 0 auto 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .logo-top {
            width: 260px;
            max-width: 260px;
            margin-bottom: 0;
        }

        .logo-top img {
            display: block;
            width: 100%;
            height: auto;
            object-fit: contain;
            filter: drop-shadow(0 3px 10px rgba(0, 0, 0, 0.24));
        }

        .hero-sticky {
            width: 100%;
            max-width: 820px;
            text-align: center;
            margin-top: 4px;
        }

        .hero-sticky h1 {
            margin: 0 0 4px;
            font-size: 24px;
            line-height: 1.12;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35);
            color: var(--gold-soft);
        }

        .hero-sticky p {
            margin: 0;
            font-size: 16px;
            line-height: 1.34;
            color: var(--gold-soft);
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
        }

        .layout {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .glass-panel {
            border: 1px solid var(--border);
            border-radius: 16px;
            background: var(--panel-bg);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
            backdrop-filter: var(--panel-blur);
        }

        .status-panel {
            padding: 10px 10px 10px;
        }

        .status-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 8px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 4px 10px;
            border: 1px solid rgba(249, 252, 186, 0.66);
            border-radius: 999px;
            background: rgba(34, 19, 2, 0.34);
            font-size: 12px;
            line-height: 1.2;
            font-weight: 700;
            color: var(--gold-soft);
            text-transform: uppercase;
            letter-spacing: 0.03em;
            white-space: nowrap;
            max-width: 100%;
        }

        .pulse {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--gold-soft);
            box-shadow: 0 0 0 rgba(249, 252, 186, 0.38);
            animation: pulse 1.8s infinite;
            flex: 0 0 auto;
        }

        .audio-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(249, 252, 186, 0.76);
            border-radius: 10px;
            background: rgba(34, 19, 2, 0.78);
            color: var(--gold-soft);
            padding: 6px 12px;
            font-size: 13px;
            line-height: 1.2;
            cursor: pointer;
            white-space: nowrap;
            backdrop-filter: var(--panel-blur);
            transition: background 0.16s ease, color 0.16s ease, border-color 0.16s ease, transform 0.14s ease;
        }

        .audio-toggle:hover {
            background: var(--button-hover-bg);
            color: var(--hover-red);
            border-color: var(--hover-red);
            transform: translateY(-1px);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 10px;
            margin-bottom: 10px;
        }

        .stat-card {
            border: 1px solid rgba(249, 252, 186, 0.30);
            border-radius: 14px;
            background: var(--panel-bg-soft);
            padding: 9px 12px;
            min-height: 66px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-width: 0;
        }

        .stat-card.action-card {
            align-items: center;
            justify-content: center;
        }

        .stat-label {
            font-size: 11px;
            line-height: 1.1;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 5px;
            color: var(--gold-soft);
            overflow-wrap: anywhere;
        }

        .stat-value {
            font-size: 24px;
            line-height: 1;
            font-weight: 700;
            color: var(--gold-soft);
            overflow-wrap: anywhere;
        }

        .stat-value.small {
            font-size: 14px;
            line-height: 1.2;
        }

        .progress-wrap {
            border: 1px solid rgba(249, 252, 186, 0.30);
            border-radius: 14px;
            background: rgba(34, 19, 2, 0.24);
            padding: 10px 12px 10px;
        }

        .progress-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 8px;
        }

        .progress-title {
            font-size: 14px;
            line-height: 1.24;
            font-weight: 700;
            color: var(--gold-soft);
            overflow-wrap: anywhere;
        }

        .progress-percent {
            font-size: 17px;
            line-height: 1;
            font-weight: 700;
            color: var(--gold-soft);
            flex: 0 0 auto;
        }

        .progress-track {
            width: 100%;
            height: 14px;
            border: 1px solid rgba(249, 252, 186, 0.28);
            border-radius: 999px;
            background: rgba(57, 35, 11, 0.38);
            overflow: hidden;
        }

        .progress-bar {
            width: 0%;
            height: 100%;
            border-radius: 999px;
            background: linear-gradient(90deg, rgba(239, 214, 136, 0.48) 0%, rgba(249, 252, 186, 0.94) 100%);
            box-shadow: 0 0 14px rgba(249, 252, 186, 0.14);
            transition: width 0.4s ease;
        }

        .progress-note {
            margin-top: 8px;
            font-size: 13px;
            line-height: 1.34;
            color: var(--gold-soft);
            overflow-wrap: anywhere;
        }

        .vacancies-panel {
            padding: 10px;
        }

        .panel-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 8px;
        }

        .panel-title h2 {
            margin: 0;
            font-size: 18px;
            line-height: 1.2;
            font-weight: 700;
            color: var(--gold-soft);
            overflow-wrap: anywhere;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 26px;
            padding: 4px 9px;
            border: 1px solid rgba(249, 252, 186, 0.34);
            border-radius: 999px;
            background: rgba(34, 19, 2, 0.30);
            font-size: 12px;
            line-height: 1.2;
            font-weight: 700;
            color: var(--gold-soft);
            white-space: nowrap;
            max-width: 100%;
        }

        .vacancy-scroll {
            max-height: 240px;
            overflow-y: auto;
            padding-right: 6px;
        }

        .vacancy-scroll::-webkit-scrollbar {
            width: 10px;
        }

        .vacancy-scroll::-webkit-scrollbar-track {
            background: rgba(34, 19, 2, 0.18);
            border-radius: 999px;
        }

        .vacancy-scroll::-webkit-scrollbar-thumb {
            background: rgba(249, 252, 186, 0.28);
            border-radius: 999px;
        }

        .vacancy-list {
            display: grid;
            gap: 10px;
        }

        .vacancy-empty {
            border: 1px dashed rgba(249, 252, 186, 0.22);
            border-radius: 14px;
            background: rgba(34, 19, 2, 0.15);
            padding: 15px 15px;
            font-size: 15px;
            line-height: 1.5;
            color: var(--gold-soft);
            overflow-wrap: anywhere;
        }

        details.vacancy-card {
            border: 1px solid rgba(249, 252, 186, 0.26);
            border-radius: 14px;
            background: rgba(34, 19, 2, 0.22);
            overflow: hidden;
        }

        details.vacancy-card[open] {
            background: rgba(34, 19, 2, 0.34);
        }

        .vacancy-summary {
            list-style: none;
            cursor: pointer;
            padding: 12px 14px;
        }

        .vacancy-summary::-webkit-details-marker {
            display: none;
        }

        .vacancy-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
        }

        .vacancy-title-block {
            min-width: 0;
        }

        .vacancy-title {
            margin: 0 0 4px;
            font-size: 17px;
            line-height: 1.3;
            font-weight: 700;
            color: var(--gold-soft);
            word-break: break-word;
        }

        .vacancy-company {
            font-size: 14px;
            line-height: 1.4;
            color: var(--gold-soft);
            opacity: 0.92;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

        .vacancy-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 9px;
        }

        .meta-chip {
            display: inline-flex;
            align-items: center;
            min-height: 25px;
            padding: 4px 9px;
            border: 1px solid rgba(249, 252, 186, 0.26);
            border-radius: 999px;
            background: rgba(34, 19, 2, 0.22);
            font-size: 12px;
            line-height: 1.2;
            color: var(--gold-soft);
            max-width: 100%;
        }

        .vacancy-body {
            padding: 0 14px 14px;
            color: var(--gold-soft);
            font-size: 14px;
            line-height: 1.48;
            overflow-wrap: anywhere;
        }

        .vacancy-body p {
            margin: 0 0 11px;
        }

        .vacancy-link,
        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(249, 252, 186, 0.78);
            border-radius: 10px;
            background: var(--button-bg);
            color: var(--gold-soft);
            padding: 9px 14px;
            font-size: 14px;
            line-height: 1.2;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.025em;
            text-decoration: none;
            cursor: pointer;
            box-shadow:
                0 8px 18px rgba(0, 0, 0, 0.16),
                inset 0 1px 0 rgba(255, 255, 255, 0.10);
            transition: transform 0.14s ease, background 0.14s ease, color 0.14s ease, border-color 0.14s ease;
            text-align: center;
        }

        .vacancy-link:hover,
        .action-btn:hover {
            background: var(--button-hover-bg);
            color: var(--hover-red);
            border-color: var(--hover-red);
            transform: translateY(-1px);
        }

        .action-btn.primary {
            display: none;
            width: 100%;
            margin-top: 12px;
        }

        @keyframes pulse {
            0% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(249, 252, 186, 0.36);
            }
            70% {
                transform: scale(1);
                box-shadow: 0 0 0 12px rgba(249, 252, 186, 0);
            }
            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(249, 252, 186, 0);
            }
        }

        @media (max-width: 980px) {
            .logo-top {
                width: min(220px, 56vw);
                max-width: none;
            }

            .layout {
                max-width: 100%;
            }

            .stats-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .page {
                padding: 16px 12px 24px;
            }
        }

        @media (max-width: 760px) {
            .page {
                padding: 16px 10px 26px;
            }

            .logo-top {
                width: min(180px, 58vw);
                max-width: none;
            }

            .hero-sticky {
                margin-top: 12px;
                max-width: 100%;
                padding: 0 4px;
            }

            .hero-sticky h1 {
                font-size: clamp(20px, 6.8vw, 26px);
            }

            .hero-sticky p {
                font-size: 14px;
                line-height: 1.5;
            }

            .status-head,
            .progress-top,
            .panel-title,
            .vacancy-top {
                flex-direction: column;
                align-items: stretch;
                gap: 10px;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .progress-percent {
                align-self: flex-start;
            }

            .audio-toggle,
            .action-btn,
            .vacancy-link {
                width: 100%;
                white-space: normal;
            }

            .eyebrow,
            .badge,
            .meta-chip {
                white-space: normal;
                overflow-wrap: anywhere;
                text-align: center;
                justify-content: center;
            }

            .vacancy-scroll {
                max-height: none;
                overflow: visible;
                padding-right: 0;
            }

            .vacancy-summary,
            .vacancy-body {
                padding-left: 12px;
                padding-right: 12px;
            }

            .vacancy-title {
                font-size: 16px;
            }
        }

        @media (max-width: 480px) {
            .page {
                padding: 12px 10px 18px;
            }

            .logo-top {
                width: min(145px, 62vw);
            }

            .hero-sticky h1 {
                font-size: 20px;
            }

            .hero-sticky p,
            .progress-note,
            .vacancy-body,
            .vacancy-company,
            .progress-title,
            .stat-value.small {
                font-size: 13px;
            }

            .stat-value {
                font-size: 20px;
            }

            .panel-title h2 {
                font-size: 16px;
            }

            .vacancy-title {
                font-size: 15px;
            }

            .status-panel,
            .vacancies-panel,
            .progress-wrap {
                padding-left: 10px;
                padding-right: 10px;
            }
        }
    </style>
</head>
<body>
    <audio id="ambient-audio" loop preload="metadata">
        <source src="{{ url_for('static', filename='matrix-theme.mp4') }}" type="audio/mp4">
    </audio>

    <div class="page">
        <div class="top-composition">
            <div class="logo-top">
                <img src="{{ url_for('static', filename='logo-white.png') }}" alt="Лаборатория влияния">
            </div>

            <div class="hero-sticky">
                <h1>Парсинг вакансий</h1>
                <p>Система выполняет глобальный поиск вакансий по вашему запросу и показывает живой прогресс обработки.</p>
            </div>
        </div>

        <div class="layout" id="pageRoot" data-request-id="{{ request_id }}">
            <section class="glass-panel status-panel">
                <div class="status-head">
                    <div class="eyebrow">
                        <span class="pulse"></span>
                        <span>Окно парсинга</span>
                    </div>

                    <button type="button" class="audio-toggle" id="audio-toggle">Музыка: выкл</button>
                </div>

                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-label">Статус</div>
                        <div class="stat-value small" id="statusValue">Подготовка к запуску</div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-label">Прогресс</div>
                        <div class="stat-value" id="progressValue">0%</div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-label">Найдено вакансий</div>
                        <div class="stat-value" id="foundValue">0</div>
                    </div>

                    <div class="stat-card action-card">
                        <a href="/job-search" class="action-btn" id="backButtonMain">Вернуться</a>
                    </div>
                </div>

                <div class="progress-wrap">
                    <div class="progress-top">
                        <div class="progress-title" id="progressTitle">Идёт запуск процесса парсинга</div>
                        <div class="progress-percent" id="progressPercent">0%</div>
                    </div>

                    <div class="progress-track" aria-hidden="true">
                        <div class="progress-bar" id="progressBar"></div>
                    </div>

                    <div class="progress-note" id="progressNote">
                        Не закрывайте страницу. Прогресс и состояние процесса обновляются автоматически.
                    </div>
                </div>
            </section>

            <section class="glass-panel vacancies-panel">
                <div class="panel-title">
                    <h2>Найденные вакансии</h2>
                    <div class="badge" id="vacancyBadge">0 позиций</div>
                </div>

                <div class="vacancy-scroll">
                    <div class="vacancy-list" id="vacancyList">
                        <div class="vacancy-empty" id="vacancyEmpty">
                            Пока вакансии ещё не поступили в окно парсинга. Как только система начнёт получать позиции по вашему запросу, они автоматически появятся здесь.
                        </div>
                    </div>
                </div>

                <a href="/job-results/{{ request_id }}" class="action-btn primary" id="resultsButton">
                    Ознакомиться с результатами
                </a>
            </section>
        </div>
    </div>

    <script>
        (function () {
            const root = document.getElementById('pageRoot');
            const requestId = root.dataset.requestId;

            const progressValue = document.getElementById('progressValue');
            const progressPercent = document.getElementById('progressPercent');
            const progressBar = document.getElementById('progressBar');
            const progressTitle = document.getElementById('progressTitle');
            const progressNote = document.getElementById('progressNote');

            const statusValue = document.getElementById('statusValue');
            const foundValue = document.getElementById('foundValue');
            const vacancyBadge = document.getElementById('vacancyBadge');
            const vacancyList = document.getElementById('vacancyList');
            const vacancyEmpty = document.getElementById('vacancyEmpty');
            const resultsButton = document.getElementById('resultsButton');
            const backButtonMain = document.getElementById('backButtonMain');

            const ambientAudio = document.getElementById('ambient-audio');
            const audioToggle = document.getElementById('audio-toggle');

            let audioEnabled = false;
            let audioContext = null;
            let statusPollTimer = null;
            let vacanciesPollTimer = null;
            let latestVacanciesSignature = '';
            let allowUnloadCancellation = true;
            let processFinished = false;
            let autoRedirectTimer = null;

            function ensureAudioContext() {
                if (!audioContext) {
                    const Ctx = window.AudioContext || window.webkitAudioContext;
                    if (Ctx) {
                        audioContext = new Ctx();
                    }
                }
                return audioContext;
            }

            function playClickSound() {
                if (!audioEnabled) {
                    return;
                }

                const ctx = ensureAudioContext();
                if (!ctx) {
                    return;
                }

                if (ctx.state === 'suspended') {
                    ctx.resume().catch(() => {});
                }

                const oscillator = ctx.createOscillator();
                const gainNode = ctx.createGain();

                oscillator.type = 'triangle';
                oscillator.frequency.setValueAtTime(720, ctx.currentTime);
                oscillator.frequency.exponentialRampToValueAtTime(430, ctx.currentTime + 0.08);

                gainNode.gain.setValueAtTime(0.0001, ctx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.09, ctx.currentTime + 0.01);
                gainNode.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.11);

                oscillator.connect(gainNode);
                gainNode.connect(ctx.destination);

                oscillator.start();
                oscillator.stop(ctx.currentTime + 0.12);
            }

            function syncAudioButton() {
                audioToggle.textContent = audioEnabled ? 'Музыка: вкл' : 'Музыка: выкл';
            }

            function startMusic() {
                if (!ambientAudio) {
                    return;
                }
                const playPromise = ambientAudio.play();
                if (playPromise && typeof playPromise.catch === 'function') {
                    playPromise.catch(() => {});
                }
            }

            function stopMusic() {
                if (!ambientAudio) {
                    return;
                }
                ambientAudio.pause();
            }

            async function cancelRequest() {
                try {
                    await fetch(`/api/v1/job-request/${requestId}/cancel`, {
                        method: 'POST',
                        headers: { 'Accept': 'application/json' },
                        keepalive: true,
                        credentials: 'same-origin'
                    });
                } catch (error) {
                    // намеренно молчим
                }
            }

            function cancelRequestByBeacon() {
                try {
                    const url = `/api/v1/job-request/${requestId}/cancel`;
                    const payload = new Blob(['{}'], { type: 'application/json' });
                    navigator.sendBeacon(url, payload);
                } catch (error) {
                    // намеренно молчим
                }
            }

            function goToResultsNow() {
                allowUnloadCancellation = false;
                processFinished = true;
                window.location.href = `/job-results/${requestId}`;
            }

            function scheduleAutoRedirectToResults() {
                if (autoRedirectTimer) {
                    return;
                }

                autoRedirectTimer = window.setTimeout(() => {
                    goToResultsNow();
                }, 1800);
            }

            audioToggle.addEventListener('click', function () {
                if (audioEnabled) {
                    playClickSound();
                    audioEnabled = false;
                    stopMusic();
                    syncAudioButton();
                    return;
                }

                audioEnabled = true;
                syncAudioButton();
                startMusic();

                const ctx = ensureAudioContext();
                if (ctx && ctx.state === 'suspended') {
                    ctx.resume().catch(() => {});
                }

                playClickSound();
            });

            backButtonMain.addEventListener('click', async function (event) {
                event.preventDefault();
                playClickSound();
                allowUnloadCancellation = false;
                await cancelRequest();
                window.location.href = '/job-search';
            });

            resultsButton.addEventListener('click', function () {
                allowUnloadCancellation = false;
                processFinished = true;
            });

            document.addEventListener('click', function (event) {
                const clickable = event.target.closest('a, button, summary, details');
                if (!clickable) {
                    return;
                }

                if (clickable.id === 'audio-toggle') {
                    return;
                }

                playClickSound();
            });

            syncAudioButton();

            function clampProgress(value) {
                const num = Number(value);
                if (!Number.isFinite(num)) {
                    return 0;
                }
                return Math.max(0, Math.min(100, Math.round(num)));
            }

            function normalizeStatus(rawStatus, rawTaskStatus) {
                const joined = `${String(rawStatus || '').toLowerCase()} ${String(rawTaskStatus || '').toLowerCase()}`;

                if (joined.includes('cancelled')) {
                    return 'cancelled';
                }
                if (joined.includes('completed') || joined.includes('done') || joined.includes('success')) {
                    return 'completed';
                }
                if (joined.includes('running') || joined.includes('started') || joined.includes('processing') || joined.includes('parsing')) {
                    return 'running';
                }
                if (joined.includes('queued') || joined.includes('waiting') || joined.includes('pending')) {
                    return 'queued';
                }
                if (joined.includes('error') || joined.includes('failed') || joined.includes('failure')) {
                    return 'failed';
                }

                return 'unknown';
            }

            function applyProgress(progress) {
                const safeProgress = clampProgress(progress);
                progressValue.textContent = `${safeProgress}%`;
                progressPercent.textContent = `${safeProgress}%`;
                progressBar.style.width = `${safeProgress}%`;

                if (safeProgress >= 100) {
                    progressTitle.textContent = 'Парсинг завершён';
                } else if (safeProgress >= 75) {
                    progressTitle.textContent = 'Завершаем сбор и подготавливаем результат';
                } else if (safeProgress >= 35) {
                    progressTitle.textContent = 'Идёт активный глобальный поиск вакансий';
                } else {
                    progressTitle.textContent = 'Идёт запуск процесса парсинга';
                }
            }

            function formatDate(value) {
                if (!value) {
                    return '';
                }

                const parsed = new Date(value);
                if (Number.isNaN(parsed.getTime())) {
                    return '';
                }

                try {
                    return parsed.toLocaleString('ru-RU', {
                        day: '2-digit',
                        month: '2-digit',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                } catch (error) {
                    return '';
                }
            }

            function escapeHtml(value) {
                return String(value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function shorten(text, maxLength) {
                const safe = String(text || '').trim();
                if (!safe) {
                    return '';
                }
                if (safe.length <= maxLength) {
                    return safe;
                }
                return `${safe.slice(0, maxLength).trim()}…`;
            }

            function pluralizePositions(count) {
                const n = Math.abs(Number(count)) || 0;
                const n10 = n % 10;
                const n100 = n % 100;

                if (n10 === 1 && n100 !== 11) {
                    return 'позиция';
                }
                if (n10 >= 2 && n10 <= 4 && (n100 < 12 || n100 > 14)) {
                    return 'позиции';
                }
                return 'позиций';
            }

            function getVacancyTitle(item, index) {
                return item.title || item.position || item.vacancy_name || item.name || `Вакансия ${index + 1}`;
            }

            function getVacancyCompany(item) {
                return item.company || item.company_name || item.employer || item.organization || 'Компания не указана';
            }

            function getVacancyUrl(item) {
                return item.url || item.link || item.vacancy_url || item.source_url || '';
            }

            function getVacancyDescription(item) {
                return item.description || item.summary || item.ai_summary || item.snippet || item.requirements || '';
            }

            function getVacancyLocation(item) {
                return item.location || item.city || item.region || '';
            }

            function getVacancySalary(item) {
                return item.salary || item.salary_text || item.compensation || '';
            }

            function getVacancySource(item) {
                return item.source || item.vacancy_source || item.platform || '';
            }

            function getVacancyCreatedAt(item) {
                return item.created_at || item.published_at || item.date || '';
            }

            function getVacancyScore(item) {
                if (item.ai_score === null || item.ai_score === undefined || item.ai_score === '') {
                    return '';
                }
                return `AI score: ${item.ai_score}`;
            }

            function normalizeVacancies(payload) {
                if (Array.isArray(payload)) {
                    return payload;
                }
                if (payload && Array.isArray(payload.vacancies)) {
                    return payload.vacancies;
                }
                if (payload && Array.isArray(payload.items)) {
                    return payload.items;
                }
                if (payload && Array.isArray(payload.data)) {
                    return payload.data;
                }
                return [];
            }

            function buildVacancyCard(item, index) {
                const title = escapeHtml(getVacancyTitle(item, index));
                const company = escapeHtml(getVacancyCompany(item));
                const url = getVacancyUrl(item);
                const description = escapeHtml(getVacancyDescription(item));
                const location = escapeHtml(getVacancyLocation(item));
                const salary = escapeHtml(getVacancySalary(item));
                const source = escapeHtml(getVacancySource(item));
                const createdAt = escapeHtml(formatDate(getVacancyCreatedAt(item)));
                const score = escapeHtml(getVacancyScore(item));

                const meta = [];
                if (location) {
                    meta.push(`<span class="meta-chip">${location}</span>`);
                }
                if (salary) {
                    meta.push(`<span class="meta-chip">${salary}</span>`);
                }
                if (source) {
                    meta.push(`<span class="meta-chip">${source}</span>`);
                }
                if (score) {
                    meta.push(`<span class="meta-chip">${score}</span>`);
                }
                if (createdAt) {
                    meta.push(`<span class="meta-chip">${createdAt}</span>`);
                }

                return `
                    <details class="vacancy-card">
                        <summary class="vacancy-summary">
                            <div class="vacancy-top">
                                <div class="vacancy-title-block">
                                    <div class="vacancy-title">${title}</div>
                                    <div class="vacancy-company">${company}</div>
                                </div>
                                <div class="badge">#${index + 1}</div>
                            </div>
                            <div class="vacancy-meta">
                                ${meta.join('')}
                            </div>
                        </summary>
                        <div class="vacancy-body">
                            ${description ? `<p>${shorten(description, 1800)}</p>` : `<p>Описание вакансии пока недоступно.</p>`}
                            ${url ? `<a class="vacancy-link" href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer">Открыть источник вакансии</a>` : ''}
                        </div>
                    </details>
                `;
            }

            function renderVacancies(vacancies) {
                const safeVacancies = normalizeVacancies(vacancies);
                const signature = JSON.stringify(safeVacancies.map(function (item) {
                    return [
                        getVacancyTitle(item, 0),
                        getVacancyCompany(item),
                        getVacancyUrl(item),
                        item.created_at || ''
                    ];
                }));

                vacancyBadge.textContent = `${safeVacancies.length} ${pluralizePositions(safeVacancies.length)}`;
                foundValue.textContent = String(safeVacancies.length);

                if (signature === latestVacanciesSignature) {
                    return;
                }

                latestVacanciesSignature = signature;

                if (!safeVacancies.length) {
                    vacancyEmpty.style.display = '';
                    vacancyList.innerHTML = '';
                    vacancyList.appendChild(vacancyEmpty);
                    return;
                }

                vacancyList.innerHTML = safeVacancies.map(buildVacancyCard).join('');
            }

            function showResultsReady(foundVacancies) {
                resultsButton.style.display = 'inline-flex';

                if (Number(foundVacancies) > 0) {
                    progressNote.textContent = `Парсинг завершён. Найдено ${foundVacancies} ${pluralizePositions(foundVacancies)}. Автоматически открываем страницу результатов...`;
                } else {
                    progressNote.textContent = 'Парсинг завершён. Автоматически открываем страницу результатов...';
                }

                scheduleAutoRedirectToResults();
            }

            async function pollVacancies() {
                try {
                    const response = await fetch(`/api/v1/vacancies/${requestId}`, {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' },
                        cache: 'no-store'
                    });

                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }

                    const data = await response.json();
                    renderVacancies(data);
                } catch (error) {
                    // продолжаем polling
                }
            }

            async function pollStatus() {
                try {
                    const response = await fetch(`/api/v1/status/${requestId}`, {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' },
                        cache: 'no-store'
                    });

                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }

                    const data = await response.json();

                    const safeStatus = normalizeStatus(data.status, data.task_status);
                    const progress = clampProgress(data.progress);
                    const foundVacancies = Number(data.found_vacancies || 0);

                    applyProgress(progress);

                    if (Number.isFinite(foundVacancies) && foundVacancies >= 0) {
                        foundValue.textContent = String(foundVacancies);
                        vacancyBadge.textContent = `${foundVacancies} ${pluralizePositions(foundVacancies)}`;
                    }

                    if (safeStatus === 'cancelled') {
                        statusValue.textContent = 'Заявка отменена';
                        progressNote.textContent = 'Возвращаемся к началу.';
                        allowUnloadCancellation = false;
                        processFinished = true;
                        window.location.href = '/job-search';
                        return;
                    }

                    if (safeStatus === 'queued') {
                        statusValue.textContent = 'Ожидание запуска';
                        progressNote.textContent = 'Задача уже поставлена в обработку. Как только начнётся фактический парсинг, прогресс станет живым.';
                    } else if (safeStatus === 'running') {
                        statusValue.textContent = 'Парсинг выполняется';
                        progressNote.textContent = 'Идёт глобальный парсинг. Прогресс, количество вакансий и карточки ниже обновляются автоматически.';
                    } else if (safeStatus === 'completed') {
                        statusValue.textContent = 'Парсинг завершён';
                        applyProgress(100);
                        processFinished = true;
                        showResultsReady(foundVacancies);
                    } else if (safeStatus === 'failed') {
                        statusValue.textContent = 'Ошибка обработки';
                        progressNote.textContent = 'Во время обработки возникла ошибка. Страница продолжит автоматически уточнять состояние.';
                    } else {
                        statusValue.textContent = 'Уточняем статус';
                        progressNote.textContent = 'Система обновляет данные. Пожалуйста, не закрывайте страницу.';
                    }

                } catch (error) {
                    statusValue.textContent = 'Связь обновляется';
                    progressNote.textContent = 'Повторяем запрос к статусу автоматически.';
                }
            }

            pollStatus();
            pollVacancies();

            statusPollTimer = window.setInterval(pollStatus, 4000);
            vacanciesPollTimer = window.setInterval(pollVacancies, 5000);

            window.addEventListener('beforeunload', function () {
                if (statusPollTimer) {
                    clearInterval(statusPollTimer);
                }

                if (vacanciesPollTimer) {
                    clearInterval(vacanciesPollTimer);
                }

                if (autoRedirectTimer) {
                    clearTimeout(autoRedirectTimer);
                }

                if (allowUnloadCancellation && !processFinished) {
                    cancelRequestByBeacon();
                }
            });
        })();
    </script>
</body>
</html>
