def _score_default_vacancy(payload: dict, vacancy: dict):
    title = vacancy.get("title") or ""
    description = vacancy.get("description") or ""
    scenario_name = vacancy.get("scenario_name") or ""
    base_ai_score = float(vacancy.get("ai_score") or 0)
 
    title_text = _clean_match_text(title)
    description_text = _clean_match_text(description)
    combined_text = _clean_match_text(" ".join([title, description]))
    scenario_text = _clean_match_text(scenario_name)
 
    score = base_ai_score
 
    heavy_negative_title = _matches_any_pattern(title_text, FINAL_HEAVY_NEGATIVE_TITLE_PATTERNS)
    noise_title = _matches_any_pattern(title_text, FINAL_NOISE_TITLE_PATTERNS)
 
    strong_product_title = _matches_any_pattern(title_text, FINAL_PRODUCT_TITLE_PATTERNS)
    strong_transformation_title = _matches_any_pattern(title_text, FINAL_TRANSFORMATION_TITLE_PATTERNS)
    strong_innovation_title = _matches_any_pattern(title_text, FINAL_INNOVATION_TITLE_PATTERNS)
    strong_project_title = _matches_any_pattern(title_text, FINAL_PROJECT_TITLE_PATTERNS)
 
    has_strong_positive_title = any(
        [
            strong_product_title,
            strong_transformation_title,
            strong_innovation_title,
            strong_project_title,
        ]
    )
 
    has_sales_marketing_context = _matches_any_pattern(combined_text, FINAL_SALES_MARKETING_CONTEXT_PATTERNS)
    has_edtech_context = _matches_any_pattern(combined_text, FINAL_EDTECH_CONTEXT_PATTERNS)
    has_digital_context = _matches_any_pattern(combined_text, FINAL_DIGITAL_CONTEXT_PATTERNS)
    has_product_context = _matches_any_pattern(combined_text, FINAL_PRODUCT_CONTEXT_PATTERNS)
    has_transformation_context = _matches_any_pattern(combined_text, FINAL_TRANSFORMATION_CONTEXT_PATTERNS)
    has_innovation_context = _matches_any_pattern(combined_text, FINAL_INNOVATION_CONTEXT_PATTERNS)
    has_cx_context = _matches_any_pattern(combined_text, FINAL_CX_CONTEXT_PATTERNS)
    has_travel_context = _matches_any_pattern(combined_text, FINAL_TRAVEL_CONTEXT_PATTERNS)
 
    if heavy_negative_title and not has_strong_positive_title:
        score -= 34
 
    if noise_title and not has_strong_positive_title:
        score -= 26
 
    if strong_product_title:
        score += 18
 
    if strong_transformation_title:
        score += 20
 
    if strong_innovation_title:
        score += 18
 
    if strong_project_title:
        score += 6
 
    score += 2 * _count_pattern_matches(combined_text, FINAL_DIGITAL_CONTEXT_PATTERNS)
    score += 3 * _count_pattern_matches(combined_text, FINAL_CX_CONTEXT_PATTERNS)
 
    if has_travel_context:
        score += 4
 
    if has_product_context:
        score += 5
 
    if has_transformation_context:
        score += 5
 
    if has_innovation_context:
        score += 5
 
    if has_sales_marketing_context:
        score -= 12
 
    if has_edtech_context:
        score -= 8
 
    if strong_project_title and not (has_product_context or has_transformation_context or has_innovation_context or has_cx_context):
        score -= 7
 
    if "маркетинг" in title_text or "marketing" in title_text:
        score -= 18
 
    if "sales" in title_text or "продаж" in title_text:
        score -= 18
 
    if "лизинг" in title_text or "leasing" in title_text:
        score -= 10
 
    if "валидац" in title_text or "сопровождени" in title_text:
        score -= 8
 
    position = _clean_match_text(payload.get("position") or "")
    if position:
        if position in title_text:
            score += 12
        else:
            matched_tokens = sum(
                1 for token in position.split()
                if len(token) > 3 and token in title_text
            )
            score += min(matched_tokens * 3, 9)
 
    for keyword in _normalize_keywords(payload.get("keywords") or [])[:6]:
        keyword_text = _clean_match_text(keyword)
        if not keyword_text or len(keyword_text) < 2:
            continue
 
        if keyword_text in title_text:
            score += 4
        elif keyword_text in description_text:
            score += 1.5
 
    if "travel" in scenario_text:
        if has_travel_context:
            score += 8
        else:
            score -= 4
 
    if "product" in scenario_text:
        if has_product_context:
            score += 9
        else:
            score -= 6
 
    if "transformation" in scenario_text:
        if has_transformation_context:
            score += 9
        else:
            score -= 6
 
    if "innovation" in scenario_text:
        if has_innovation_context:
            score += 9
        else:
            score -= 6
 
    if "adjacent_industry" in scenario_text and has_travel_context:
        score += 4
 
    if "alternate_role" in scenario_text and has_strong_positive_title:
        score += 3
 
    must_have_signal = has_strong_positive_title or has_digital_context
    if not must_have_signal:
        score -= 20
 
    if score < 1:
        score = 1.0
    if score > 100:
        score = 100.0
 
    return float(score)
 
 
def _score_final_vacancy(payload: dict, vacancy: dict):
    if _get_product_domain(payload) == "commercial_it_enterprise":
        return _score_commercial_it_enterprise_vacancy(payload, vacancy)
 
    return _score_default_vacancy(payload, vacancy)
 
 
