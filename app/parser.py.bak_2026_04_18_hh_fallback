def _should_keep_final_vacancy(vacancy: dict, payload: dict):
    if _get_product_domain(payload) == "commercial_it_enterprise":
        return _should_keep_commercial_it_enterprise_vacancy(vacancy)
 
    return _should_keep_default_vacancy(vacancy)
 
 
def _apply_final_post_ranking(vacancies, payload):
    ranked = []
 
    for item in vacancies:
        vacancy = dict(item)
        vacancy["final_score"] = _score_final_vacancy(payload, vacancy)
 
        if not _should_keep_final_vacancy(vacancy, payload):
            continue
 
        ranked.append(vacancy)
 
    ranked.sort(
        key=lambda item: (
            item.get("final_score") or 0,
            item.get("ai_score") or 0,
            _normalize_text(item.get("title") or ""),
        ),
        reverse=True,
    )
 
    return ranked
 
 
def run_parser(job_request_id: int):
    db = app.db_session
 
    job_request = (
        db.query(JobRequest)
        .filter(JobRequest.id == job_request_id)
        .first()
    )
    if not job_request:
        raise ValueError("job request not found")
 
    payload, agent_plan = _build_agent_payload(job_request)
 
    enabled_sources = _get_enabled_sources()
    preferred_sources = payload.get("source_priority") or []
    enabled_sources = _reorder_sources(enabled_sources, preferred_sources)
 
    vacancies = []
    sources_checked = []
    source_errors = []
 
    for source_name in enabled_sources:
        if source_name == "manual":
            sources_checked.append("manual")
            try:
                vacancies.extend(_run_manual_source(payload))
            except Exception as exc:
                source_errors.append(
                    {
                        "source": "manual",
                        "error": str(exc),
                    }
                )
 
        elif source_name == "mock":
            sources_checked.append("mock")
            vacancies.extend(_run_mock_source(payload))
 
        elif source_name == "hh":
            sources_checked.append("hh")
            try:
                vacancies.extend(_run_hh_with_scenarios(payload))
            except Exception as exc:
                source_errors.append(
                    {
                        "source": "hh",
                        "error": str(exc),
                    }
                )
 
        elif source_name == "linkedin":
            sources_checked.append("linkedin")
            try:
                vacancies.extend(_run_linkedin_with_scenarios(payload))
            except Exception as exc:
                source_errors.append(
                    {
                        "source": "linkedin",
                        "error": str(exc),
                    }
                )
 
    vacancies = _deduplicate_vacancies(vacancies)
    vacancies = _apply_final_post_ranking(vacancies, payload)
 
    limit = Config.PARSER_RESULTS_LIMIT
    vacancies = vacancies[:limit]
 
    return {
        "job_request_id": payload["job_request_id"],
        "search_payload": payload,
        "agent_plan": agent_plan,
        "sources_checked": sources_checked,
        "source_errors": source_errors,
        "vacancies_found": vacancies,
        "total_found": len(vacancies),
    }
