def _extract_resume_text_for_agent(job_request: JobRequest) -> str:
    raw_path = (job_request.resume_file_path or "").strip()
    raw_name = (job_request.resume_file_name or "").strip()
 
    if not raw_path and not raw_name:
        return ""
 
    app_dir = Path(app.__file__).resolve().parent
    project_dir = app_dir.parent
 
    candidate_paths = []
 
    if raw_path:
        path_obj = Path(raw_path)
        if path_obj.is_absolute():
            candidate_paths.append(path_obj)
        else:
            cleaned_relative = raw_path.lstrip("./")
            candidate_paths.append(project_dir / cleaned_relative)
            candidate_paths.append(app_dir / cleaned_relative)
 
    if raw_name:
        candidate_paths.append(app_dir / "uploads" / "resumes" / raw_name)
 
    seen = set()
    resolved_candidates = []
    for item in candidate_paths:
        normalized = str(item)
        if normalized in seen:
            continue
        seen.add(normalized)
        resolved_candidates.append(item)
 
    file_path = next((path for path in resolved_candidates if path.exists() and path.is_file()), None)
    if not file_path:
        return ""
 
    try:
        from app.routes import _extract_resume_text, _clean_resume_text
 
        resume_text = _extract_resume_text(file_path)
        return _clean_resume_text(resume_text)
    except Exception:
        return ""
 
 
def _sanitize_source_priority(source_priority):
    cleaned = []
    seen = set()
 
    for item in source_priority or []:
        value = _normalize_text(item)
        if not value:
            continue
        if value not in ALLOWED_SOURCE_NAMES:
            continue
        if value in seen:
            continue
        seen.add(value)
        cleaned.append(value)
 
    return cleaned
 
 
def _sanitize_query_text(primary_query: str, profile: dict, strategy: dict, job_request: JobRequest):
    position = (profile.get("primary_role") or job_request.position or "").strip()
    industry = (profile.get("industry") or "").strip()
    location = (profile.get("location") or job_request.location or "").strip()
    keywords = strategy.get("keyword_variants") or []
    keywords = [str(x).strip() for x in keywords if str(x).strip()][:3]
 
    parts = []
    if position:
        parts.append(position)
    if industry and industry.lower() != position.lower():
        parts.append(industry)
    if location:
        parts.append(location)
    if keywords:
        parts.append(", ".join(keywords))
 
    compact = " | ".join(parts).strip()
    if compact:
        return compact
 
    return (primary_query or job_request.query_text or "").strip()
 
 
def _sanitize_scenarios(scenarios):
    cleaned = []
    seen = set()
 
    for item in scenarios or []:
        if not isinstance(item, dict):
            continue
 
        name = str(item.get("name") or "").strip()
        role = str(item.get("role") or "").strip()
        industry = str(item.get("industry") or "").strip()
        query = str(item.get("query") or "").strip()
        keywords = item.get("keywords") or []
 
        if not role or not query:
            continue
 
        key = f"{role.lower()}::{industry.lower()}::{query.lower()}"
        if key in seen:
            continue
        seen.add(key)
 
        cleaned.append(
            {
                "name": name,
                "role": role,
                "industry": industry,
                "query": query,
                "keywords": [str(x).strip() for x in keywords if str(x).strip()][:6],
            }
        )
 
    return cleaned[:8]
 
 
def _apply_management_guardrails(payload: dict, plan: dict) -> tuple[dict, dict]:
    management = plan.get("management") or {}
    risk_level = str(management.get("risk_level") or "").strip().lower()
 
    payload = dict(payload)
    plan = dict(plan)
 
    payload["management"] = management
 
    if risk_level == "high":
        scenarios = payload.get("scenarios") or []
        if scenarios:
            payload["scenarios"] = scenarios[:1]
 
        query_variants = payload.get("query_variants") or []
        if query_variants:
            payload["query_variants"] = query_variants[:1]
 
        source_priority = payload.get("source_priority") or []
        if "hh" in source_priority:
            payload["source_priority"] = ["hh"]
        elif source_priority:
            payload["source_priority"] = source_priority[:1]
        else:
            payload["source_priority"] = ["hh"]
 
        diagnostics = dict(payload.get("diagnostics") or {})
        recommendations = list(diagnostics.get("recommendations") or [])
        guardrail_note = "Включён безопасный режим: только primary-сценарий и базовый источник поиска."
        if guardrail_note not in recommendations:
            recommendations.append(guardrail_note)
        diagnostics["recommendations"] = recommendations[:10]
        payload["diagnostics"] = diagnostics
 
    diagnostics = dict(payload.get("diagnostics") or {})
    diagnostics["guardrails_applied"] = (risk_level == "high")
    diagnostics["effective_scenarios_count"] = len(payload.get("scenarios") or [])
    diagnostics["effective_query_variants_count"] = len(payload.get("query_variants") or [])
    diagnostics["effective_source_priority_count"] = len(payload.get("source_priority") or [])
    payload["diagnostics"] = diagnostics
 
    return payload, plan
 
 
def _build_agent_payload(job_request: JobRequest):
    form_data = _build_agent_context_form_data(job_request)
    resume_text = _extract_resume_text_for_agent(job_request)
    plan = build_agent_plan(
        resume_text=resume_text,
        form_data=form_data,
        job_request=job_request,
    )
 
    profile = plan.get("profile", {})
    strategy = plan.get("strategy", {})
    diagnostics = plan.get("diagnostics", {})
    management = plan.get("management", {})
 
    role_variants = strategy.get("role_variants") or []
    industry_variants = strategy.get("industry_variants") or []
    keyword_variants = strategy.get("keyword_variants") or []
    query_variants = strategy.get("query_variants") or []
    source_priority = _sanitize_source_priority(strategy.get("source_priority") or [])
    scenarios = _sanitize_scenarios(strategy.get("scenarios") or [])
 
    primary_query = _sanitize_query_text(
        primary_query=strategy.get("primary_query") or "",
        profile=profile,
        strategy=strategy,
        job_request=job_request,
    )
 
    payload = {
        "job_request_id": job_request.id,
        "query_text": primary_query,
        "position": profile.get("primary_role") or job_request.position,
        "keywords": keyword_variants or _normalize_keywords(job_request.keywords),
        "location": profile.get("location") or job_request.location,
        "salary_min": float(job_request.salary_min) if job_request.salary_min is not None else None,
        "salary_max": float(job_request.salary_max) if job_request.salary_max is not None else None,
        "employment_type": job_request.employment_type,
        "remote": bool(job_request.remote),
        "work_format": job_request.work_format,
        "role_variants": role_variants,
        "industry_variants": industry_variants,
        "query_variants": query_variants,
        "source_priority": source_priority,
        "scenarios": scenarios,
        "agent_profile": profile,
        "agent_strategy": strategy,
        "diagnostics": diagnostics,
        "management": management,
    }
 
    payload, plan = _apply_management_guardrails(payload, plan)
    return payload, plan
 
 
def build_search_payload(job_request_id: int):
    db = app.db_session
 
    job_request = (
        db.query(JobRequest)
        .filter(JobRequest.id == job_request_id)
        .first()
    )
    if not job_request:
        raise ValueError("job request not found")
 
    payload, _plan = _build_agent_payload(job_request)
    return payload
 
 
