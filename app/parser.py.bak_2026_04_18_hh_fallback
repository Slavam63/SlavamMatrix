    has_exec_title = _matches_any_pattern(title_text, COMMERCIAL_EXECUTIVE_TITLE_PATTERNS)
    has_enterprise_context = _matches_any_pattern(combined_text, COMMERCIAL_ENTERPRISE_CONTEXT_PATTERNS)
