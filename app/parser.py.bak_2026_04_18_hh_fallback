    if has_exec_title:
        score += 22
 
    if has_enterprise_context:
        score += 4 * _count_pattern_matches(combined_text, COMMERCIAL_ENTERPRISE_CONTEXT_PATTERNS)
 
    if "commercial director" in title_text or "коммерческий директор" in title_text:
        score += 10
    if "sales director" in title_text or "директор по продажам" in title_text:
        score += 10
    if "business development director" in title_text or "директор по развитию бизнеса" in title_text:
        score += 10
    if "enterprise sales" in combined_text:
        score += 8
    if "channel sales" in combined_text or "канальн" in combined_text:
        score += 8
    if "partner sales" in combined_text or "партнерск" in combined_text:
        score += 8
    if "vendor" in combined_text or "вендор" in combined_text:
        score += 7
    if "cloud" in combined_text or "saas" in combined_text or "software" in combined_text:
        score += 6
    if "information security" in combined_text or "security" in combined_text:
        score += 5
    if "oracle" in combined_text or "ibm" in combined_text or "veritas" in combined_text or "myoffice" in combined_text or "мойофис" in combined_text:
        score += 6
    if "b2b" in combined_text:
        score += 5
    if "key account" in combined_text:
        score += 4
 
    if has_negative_title:
        score -= 24
 
    if "marketing" in title_text or "маркетинг" in title_text:
        score -= 20
    if "retail" in combined_text or "розниц" in combined_text:
        score -= 18
    if "account manager" in title_text:
        score -= 16
    if "sales manager" in title_text or "менеджер по продажам" in title_text:
        score -= 18
    if "customer success" in title_text:
        score -= 14
    if "assistant" in title_text or "ассистент" in title_text:
        score -= 20
 
    position = _clean_match_text(payload.get("position") or "")
    if position:
        if position in title_text:
            score += 12
        else:
            matched_tokens = sum(
                1 for token in position.split()
                if len(token) > 3 and token in title_text
            )
            score += min(matched_tokens * 3, 9)
 
    for keyword in _normalize_keywords(payload.get("keywords") or [])[:8]:
        keyword_text = _clean_match_text(keyword)
        if not keyword_text or len(keyword_text) < 2:
            continue
 
        if keyword_text in title_text:
            score += 4
        elif keyword_text in description_text:
            score += 1.5
 
    if "cloud" in scenario_text or "saas" in scenario_text:
        if "cloud" in combined_text or "saas" in combined_text or "software" in combined_text:
            score += 8
        else:
            score -= 5
 
    if "security" in scenario_text or "vendor" in scenario_text:
        if "security" in combined_text or "vendor" in combined_text or "вендор" in combined_text:
            score += 8
        else:
            score -= 5
 
    if "enterprise" in scenario_text:
        if has_enterprise_context:
            score += 7
        else:
            score -= 5
 
    if not has_exec_title and not has_enterprise_context:
        score -= 14
 
    if score < 1:
        score = 1.0
