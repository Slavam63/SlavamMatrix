    all_vacancies = []
 
    for scenario in scenarios:
        scenario_payload = _build_payload_for_scenario(payload, scenario)
        scenario_vacancies = search_linkedin_vacancies(scenario_payload)
 
        for vacancy in scenario_vacancies:
            if not vacancy.get("scenario_name"):
                vacancy["scenario_name"] = scenario_payload.get("scenario_name")
            all_vacancies.append(vacancy)
 
    return all_vacancies
 
 
