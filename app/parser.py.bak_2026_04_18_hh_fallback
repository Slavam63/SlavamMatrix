def _run_manual_source(payload: dict):
    db = app.db_session
 
    rows = (
        db.query(Vacancy)
        .filter(Vacancy.job_request_id == payload["job_request_id"])
        .order_by(Vacancy.id.desc())
        .all()
    )
 
    result = []
 
    for item in rows:
        result.append(
            {
                "source": item.source or "manual",
                "external_id": item.external_id,
                "title": item.title or "Untitled vacancy",
                "company": item.company,
                "location": item.location,
                "salary": item.salary,
                "url": item.url or "",
                "description": item.description,
                "employment_type": item.employment_type,
                "remote": bool(item.remote),
                "ai_score": float(item.ai_score) if item.ai_score is not None else 0.0,
                "scenario_name": "manual_input",
            }
        )
 
    return result
 
 
def _reorder_sources(enabled_sources, preferred_sources):
    if not preferred_sources:
        return enabled_sources
 
    ordered = []
    for source in preferred_sources:
        if source in enabled_sources and source not in ordered:
            ordered.append(source)
 
    for source in enabled_sources:
        if source not in ordered:
            ordered.append(source)
 
    return ordered
 
 
def _build_payload_for_scenario(payload: dict, scenario: dict) -> dict:
    scenario_keywords = scenario.get("keywords") or payload.get("keywords") or []
    scenario_industry = scenario.get("industry") or ""
    scenario_query = scenario.get("query") or payload.get("query_text") or ""
 
    scenario_payload = dict(payload)
    scenario_payload["position"] = scenario.get("role") or payload.get("position")
    scenario_payload["query_text"] = scenario_query
    scenario_payload["keywords"] = scenario_keywords
    scenario_payload["industry_variants"] = [scenario_industry] if scenario_industry else payload.get("industry_variants") or []
    scenario_payload["query_variants"] = [scenario_query] if scenario_query else payload.get("query_variants") or []
    scenario_payload["scenario_name"] = scenario.get("name") or "scenario"
 
    return scenario_payload
 
 
def _run_hh_with_scenarios(payload: dict):
    scenarios = payload.get("scenarios") or []
    if not scenarios:
        return search_hh_vacancies(payload)
 
    all_vacancies = []
 
    for scenario in scenarios:
        scenario_payload = _build_payload_for_scenario(payload, scenario)
        scenario_vacancies = search_hh_vacancies(scenario_payload)
 
        for vacancy in scenario_vacancies:
            if not vacancy.get("scenario_name"):
                vacancy["scenario_name"] = scenario_payload.get("scenario_name")
            all_vacancies.append(vacancy)
 
    return all_vacancies
 
 
