def _normalize_keywords(keywords_value):
    if not keywords_value:
        return []
 
    if isinstance(keywords_value, list):
        return [str(item).strip() for item in keywords_value if str(item).strip()]
 
    return [
        item.strip()
        for item in str(keywords_value).split(",")
        if item.strip()
    ]
 
 
def _normalize_text(value):
    if not value:
        return ""
 
    text = str(value).lower().strip()
    text = re.sub(r"\s+", " ", text)
    return text
 
 
def _normalize_url(value):
    if not value:
        return ""
 
    text = str(value).strip()
    text = re.sub(r"#.*$", "", text)
    text = re.sub(r"\?.*$", "", text)
    return text.rstrip("/").lower()
 
 
def _clean_match_text(value):
    if not value:
        return ""
 
    text = str(value).lower()
    text = text.replace("c++", "cpp")
    text = text.replace("node. js", "node.js")
    text = text.replace("node js", "nodejs")
    text = re.sub(r"[^\w\s\.\-\+#/]", " ", text, flags=re.UNICODE)
    text = re.sub(r"\s+", " ", text).strip()
    return text
 
 
def _matches_any_pattern(text: str, patterns):
    return any(re.search(pattern, text, flags=re.IGNORECASE) for pattern in patterns)
 
 
def _count_pattern_matches(text: str, patterns):
    count = 0
    for pattern in patterns:
        if re.search(pattern, text, flags=re.IGNORECASE):
            count += 1
    return count
 
 
def _build_vacancy_dedup_key(item: dict):
    source = _normalize_text(item.get("source") or "unknown")
    external_id = _normalize_text(item.get("external_id"))
 
    if external_id:
        return f"external::{source}::{external_id}"
 
    title = _normalize_text(item.get("title"))
    company = _normalize_text(item.get("company"))
    url = _normalize_url(item.get("url"))
 
    return f"fallback::{source}::{title}::{company}::{url}"
 
 
def _deduplicate_vacancies(vacancies):
    result = []
    seen_keys = set()
 
    for item in vacancies:
        dedup_key = _build_vacancy_dedup_key(item)
 
        if dedup_key in seen_keys:
            continue
 
        seen_keys.add(dedup_key)
        result.append(item)
 
    return result
 
 
